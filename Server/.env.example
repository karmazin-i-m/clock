# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Postgres superuser — used only by the db container itself and 00_bootstrap.sql.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kclock

# The three roles 00_bootstrap.sql creates (DESIGN.md §8). Three separate, unrelated
# passwords — never reuse one across roles.
CLOCK_MIGRATOR_PASSWORD=
CLOCK_APP_PASSWORD=
CLOCK_INGEST_PASSWORD=

# Google Cloud OAuth 2.0 Web client. Redirect URI must be
# https://<DOMAIN>/auth/google/callback, registered in the Google Cloud Console first.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The domain Caddy requests a certificate for and the SPA is served from.
DOMAIN=

# Where Data Protection keys persist across redeploys (DESIGN.md §12, Ops papercut 1) — must
# be a path backed by a named volume in compose.yaml, never the container's writable layer.
DATA_PROTECTION_KEYS_PATH=/data/dp-keys
