# /etc/kclock/kclock.env on the API host, 600 root:root. systemd reads it before dropping to
# the kclock user, so the service gets these values without being able to read the file.
# The migrator's connection string is not here: it lives in /etc/kclock/migrator.conn, which
# only deploy.sh reads, so the running API never holds a role that can change the schema.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:8080

ConnectionStrings__App="Host=192.168.23.8;Database=kclock;Username=clock_app;Password=;Maximum Pool Size=20"
ConnectionStrings__Ingest="Host=192.168.23.8;Database=kclock;Username=clock_ingest;Password=;Maximum Pool Size=20"

# Redirect URI https://<domain>/auth/google/callback, registered in the Google Cloud Console.
Authentication__Google__ClientId=
Authentication__Google__ClientSecret=

# Survives redeploys; losing it signs every user out (DESIGN.md §12, Ops papercut 1).
DataProtectionKeysPath=/var/lib/kclock/dp-keys

# The Caddy host. Forwarded headers from any other address are ignored (DESIGN.md §12,
# Ops papercut 2); left out, Google sign-in builds an http:// redirect_uri and fails.
ReverseProxy__TrustedProxies=

OpenApi__Enabled=false
